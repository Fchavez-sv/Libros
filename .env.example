# Copia este archivo como .env.local y ajusta los valores si es necesario.

# Nombre de la aplicación (se muestra en el encabezado y en el título de la pestaña).
NEXT_PUBLIC_APP_NAME="Buscador de Libros"

# URL base de la API de Open Library (solo se usa en el servidor).
OPEN_LIBRARY_API_URL="https://openlibrary.org"

# URL base de las portadas de Open Library (se usa en el navegador).
NEXT_PUBLIC_COVERS_URL="https://covers.openlibrary.org"
